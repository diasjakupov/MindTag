    classDef plat fill:#fde68a,stroke:#92400e,color:#1f2937;
    classDef ui   fill:#dbeafe,stroke:#1e3a8a,color:#0f172a;
    classDef vm   fill:#dcfce7,stroke:#166534,color:#0f172a;
    classDef uc   fill:#fef3c7,stroke:#854d0e,color:#0f172a;
    classDef repo fill:#fce7f3,stroke:#9d174d,color:#0f172a;
    classDef data fill:#cffafe,stroke:#155e75,color:#0f172a;
    classDef core fill:#ede9fe,stroke:#5b21b6,color:#0f172a;

    PLAT["Platforms<br/>Android, iOS, Desktop JVM"]:::plat
    UI["UI Layer — Compose Multiplatform<br/>10 screens, Navigation, Auth gate"]:::ui
    VM["ViewModel Layer — MVI<br/>10 ViewModels, StateFlow + Intent"]:::vm
    UC["Use Case Layer — Domain<br/>10 use cases (notes, quiz, auth, study)"]:::uc
    REPO["Repository Layer<br/>Note, Study, Quiz, BackendQuiz, Auth"]:::repo

    SQL["SQLite — SQLDelight<br/>7 tables"]:::data
    KTOR["Ktor HttpClient<br/>Bearer JWT"]:::data

    KOIN["Koin DI<br/>6 modules"]:::core
    AUTH["AuthManager<br/>StateFlow&lt;AuthState&gt;"]:::core
    ENV["EnvironmentStore<br/>TEST / NETWORK toggle"]:::core
    DSY["Design System<br/>Colors, Icons, Shapes, Spacing"]:::core

    PLAT --> UI --> VM --> UC --> REPO
    REPO --> SQL
    REPO --> KTOR
    KTOR --> AUTH

    KOIN -. provides .-> VM
    ENV  -. stub/real .-> REPO

    linkStyle default stroke:#475569,stroke-width:1.4px;
